{
  "plexi_version": "0.1",
  "name": "parallax",
  "version": "0.1.0",
  "description": "Video agent pipeline CLI",
  "icon": "🎬",
  "default_view": "list",
  "commands": [
    {
      "name": "run",
      "description": "Kick off a footage_edit run in cwd",
      "icon": "▶",
      "ui_hint": "form",
      "args": [
        {
          "name": "brief",
          "type": "string",
          "required": true,
          "description": "What you want the agent to create",
          "placeholder": "western cowboy scene, 8 seconds"
        }
      ],
      "flags": [
        {"name": "--test-mode", "type": "bool", "default": false}
      ],
      "writes": [".parallax/"],
      "streaming": true
    },
    {
      "name": "status",
      "description": "Print manifest stats",
      "ui_hint": "output",
      "args": [],
      "output_format": "yaml"
    },
    {
      "name": "project",
      "description": "Project management",
      "commands": [
        {
          "name": "new",
          "args": [{"name": "name", "type": "string", "required": true}]
        },
        {"name": "list"}
      ]
    }
  ],
  "live_state": {
    "source": "file",
    "path": ".parallax/manifest.yaml",
    "poll_ms": 1000,
    "format": "yaml"
  }
}
