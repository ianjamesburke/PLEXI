#!/usr/bin/env python3
"""
hello-app — minimal Plexi app example.

Demonstrates:
  - Init / Render / Key / Command event handling
  - Drawing rects, text, and a list
  - Sending RunInTerminal commands back to the shell
  - Emitting a test notification (press 'n')

Drop this in ~/.plexi/apps/hello-app/bin/plexi-app (chmod +x) and add
the manifest.toml alongside it.
"""

import sys
import json

def send(obj):
    print(json.dumps(obj), flush=True)

width = 800
height = 600
items = [
    {"label": "Say Hello",     "secondary": "echo hello",        "is_dir": False},
    {"label": "Show date",     "secondary": "date",              "is_dir": False},
    {"label": "List files",    "secondary": "ls -la",            "is_dir": False},
    {"label": "System info",   "secondary": "uname -a",          "is_dir": False},
]
selected = 0
last_command = None

COMMANDS = [item["secondary"] for item in items]

def render():
    # Background
    send({"type": "rect", "x": 0, "y": 0, "w": width, "h": height,
          "fill": "#1e1e2e", "radius": 0})

    # Header bar
    send({"type": "rect", "x": 0, "y": 0, "w": width, "h": 44,
          "fill": "#181825", "radius": 0})
    send({"type": "text", "x": 20, "y": 14, "text": "Hello App",
          "size": 14.0, "color": "#cdd6f4", "bold": True})
    send({"type": "text", "x": 20, "y": 30,
          "text": "Arrows/Enter to run commands — 'n' to emit a test notification",
          "size": 10.0, "color": "#585b70"})

    # Divider
    send({"type": "line", "x1": 0, "y1": 44, "x2": width, "y2": 44,
          "color": "#313244", "width": 1.0})

    # Command list
    send({
        "type": "list",
        "items": items,
        "selected": selected,
        "item_height": 28.0,
    })

    # Status bar at bottom
    if last_command:
        send({"type": "rect", "x": 0, "y": height - 28, "w": width, "h": 28,
              "fill": "#181825", "radius": 0})
        send({"type": "text", "x": 20, "y": height - 18,
              "text": f"Last: {last_command}",
              "size": 10.0, "color": "#a6e3a1", "monospace": True})

    send({"type": "frame_done"})

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue

    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        continue

    t = event.get("type")

    if t == "init":
        width = event.get("width", 800)
        height = event.get("height", 600)

    elif t == "render":
        width = event.get("width", width)
        height = event.get("height", height)
        render()

    elif t == "resize":
        width = event.get("width", width)
        height = event.get("height", height)

    elif t == "key":
        key = event.get("key", "")
        if key == "ArrowDown":
            selected = min(selected + 1, len(items) - 1)
        elif key == "ArrowUp":
            selected = max(selected - 1, 0)
        elif key == "Enter":
            cmd = COMMANDS[selected]
            last_command = cmd
            send({"type": "run_in_terminal", "command": cmd})
        elif key == "n":
            # Round-trip test: emit a notification. Plexi should record it to
            # ~/.plexi-alpha/notifications.jsonl, increment the status-bar
            # unread count, and surface it in the palette (Cmd+Shift+N).
            send({
                "type": "notification",
                "priority": 1,
                "title": "Hello from hello-app",
                "body": "Test notification emitted via the draw channel.",
                "source_app": "hello-app",
            })
            last_command = "notification"

    elif t == "command":
        # User typed something in the terminal command bar
        text = event.get("text", "").strip()
        if text.isdigit():
            idx = int(text) - 1
            if 0 <= idx < len(items):
                selected = idx
                cmd = COMMANDS[selected]
                last_command = cmd
                send({"type": "run_in_terminal", "command": cmd})
        else:
            last_command = text
            send({"type": "run_in_terminal", "command": text})

    elif t == "shutdown":
        sys.exit(0)
