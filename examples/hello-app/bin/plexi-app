#!/usr/bin/env python3
"""
hello-app — minimal Plexi app example.

Demonstrates:
  - Init / Render / Key / Command event handling
  - Drawing rects, text, and a list
  - Sending RunInTerminal commands back to the shell
  - Emitting a test notification (press 'n')
  - Declaring a drop target and handling Drop events

Drop this in ~/.plexi/apps/hello-app/bin/plexi-app (chmod +x) and add
the manifest.toml alongside it.
"""

import sys
import json

def send(obj):
    print(json.dumps(obj), flush=True)

def log(level, message):
    send({"type": "log", "level": level, "message": message})

width = 800
height = 600
items = [
    {"label": "Say Hello",     "secondary": "echo hello",        "is_dir": False},
    {"label": "Show date",     "secondary": "date",              "is_dir": False},
    {"label": "List files",    "secondary": "ls -la",            "is_dir": False},
    {"label": "System info",   "secondary": "uname -a",          "is_dir": False},
]
selected = 0
last_command = None
dropped_paths: list[str] = []  # most recent drop result, shown in the drop zone

COMMANDS = [item["secondary"] for item in items]

def render():
    # Background
    send({"type": "rect", "x": 0, "y": 0, "w": width, "h": height,
          "fill": "#1e1e2e", "radius": 0})

    # Header bar
    send({"type": "rect", "x": 0, "y": 0, "w": width, "h": 44,
          "fill": "#181825", "radius": 0})
    send({"type": "text", "x": 20, "y": 14, "text": "Hello App",
          "size": 14.0, "color": "#cdd6f4", "bold": True})
    send({"type": "text", "x": 20, "y": 30,
          "text": "Arrows/Enter to run commands — 'n' to emit a test notification",
          "size": 10.0, "color": "#585b70"})

    # Divider
    send({"type": "line", "x1": 0, "y1": 44, "x2": width, "y2": 44,
          "color": "#313244", "width": 1.0})

    # Command list (top half, above the drop zone)
    drop_zone_h = 120
    drop_zone_y = max(60, height - drop_zone_h - 40)
    send({
        "type": "list",
        "items": items,
        "selected": selected,
        "item_height": 28.0,
    })

    # Drop zone — drag files from Finder here.
    send({"type": "rect",
          "x": 20, "y": drop_zone_y, "w": width - 40, "h": drop_zone_h,
          "fill": "#1a1b26", "radius": 8})
    send({"type": "text", "x": 40, "y": drop_zone_y + 16,
          "text": "Drop files here",
          "size": 12.0, "color": "#89b4fa", "bold": True})
    if dropped_paths:
        for i, p in enumerate(dropped_paths[:4]):
            send({"type": "text", "x": 40, "y": drop_zone_y + 40 + i * 14,
                  "text": p, "size": 10.0, "color": "#a6e3a1",
                  "monospace": True})
    else:
        send({"type": "text", "x": 40, "y": drop_zone_y + 40,
              "text": "(drag any file from Finder onto this area)",
              "size": 10.0, "color": "#585b70"})

    # Register the drop target with Plexi. Empty accept = accept anything.
    # This must be re-emitted every frame; Plexi does not persist it.
    send({
        "type": "drop_target",
        "id": "assets",
        "x": 20, "y": drop_zone_y,
        "w": width - 40, "h": drop_zone_h,
        "accept": [],
        "label": "Drop to add to hello-app",
    })

    # Status bar at bottom
    if last_command:
        send({"type": "rect", "x": 0, "y": height - 28, "w": width, "h": 28,
              "fill": "#181825", "radius": 0})
        send({"type": "text", "x": 20, "y": height - 18,
              "text": f"Last: {last_command}",
              "size": 10.0, "color": "#a6e3a1", "monospace": True})

    send({"type": "frame_done"})

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue

    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        continue

    t = event.get("type")

    if t == "init":
        width = event.get("width", 800)
        height = event.get("height", 600)

    elif t == "render":
        width = event.get("width", width)
        height = event.get("height", height)
        render()

    elif t == "resize":
        width = event.get("width", width)
        height = event.get("height", height)

    elif t == "key":
        key = event.get("key", "")
        if key == "ArrowDown":
            selected = min(selected + 1, len(items) - 1)
        elif key == "ArrowUp":
            selected = max(selected - 1, 0)
        elif key == "Enter":
            cmd = COMMANDS[selected]
            last_command = cmd
            send({"type": "run_in_terminal", "command": cmd})
        elif key == "n":
            # Round-trip test: emit a notification. Plexi should record it to
            # ~/.plexi-alpha/notifications.jsonl, increment the status-bar
            # unread count, and surface it in the palette (Cmd+Shift+N).
            send({
                "type": "notification",
                "priority": 1,
                "title": "Hello from hello-app",
                "body": "Test notification emitted via the draw channel.",
                "source_app": "hello-app",
            })
            last_command = "notification"

    elif t == "drop":
        target_id = event.get("target_id", "")
        paths = event.get("paths", [])
        dropped_paths = paths
        # Print to stderr so we can verify the round-trip end-to-end
        # (stderr from external apps is forwarded to plexi.log).
        print(f"hello-app: drop on '{target_id}' -> {paths}", file=sys.stderr, flush=True)
        log("info", f"drop on '{target_id}': {len(paths)} file(s)")

    elif t == "command":
        # User typed something in the terminal command bar
        text = event.get("text", "").strip()
        if text.isdigit():
            idx = int(text) - 1
            if 0 <= idx < len(items):
                selected = idx
                cmd = COMMANDS[selected]
                last_command = cmd
                send({"type": "run_in_terminal", "command": cmd})
        else:
            last_command = text
            send({"type": "run_in_terminal", "command": text})

    elif t == "shutdown":
        sys.exit(0)
