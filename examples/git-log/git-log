def _render_row(ctx, item, i, x, y, w, is_sel):
    hash_str, subject = item
    if is_sel:
        ctx.rect(x, y, w, ROW_H, fill=THEME.highlight)

    text_color = THEME.fg if is_sel else THEME.muted
    text_y = y + (ROW_H - BODY) / 2

    ctx.text(
        x + PAD, text_y, subject,
        size=BODY, color=text_color, bold=is_sel,
    )
    # Hash on the right (monospace, dimmed), host measures exact width.
