#!/usr/bin/env python3
from __future__ import annotations
"""
git-log — Plexi app
Browse recent git commits for the linked terminal's working directory.

Controls:
  j / ArrowDown   Next commit
  k / ArrowUp     Previous commit
  Enter           Run `git show <hash>` in linked terminal
  r               Refresh log
  ⌘W              Close app (host-handled)

Phase 1 SDK components layer: uses ctx.header, ctx.status_bar,
ctx.scrollable_list, ctx.empty_state, THEME. No hand-rolled scroll math,
no local palette, no pixel-guess right-alignment.
"""

import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from plexi_sdk import (
    App,
    THEME,
    BODY, CAPTION, MONO_SMALL,
    PAD,
)

app = App()

commits: list[tuple[str, str]] = []  # list of (short_hash, subject)
selected = 0


def load_commits() -> None:
    global commits
    try:
        result = subprocess.run(
            ["git", "log", "--oneline", "-40"],
            capture_output=True, text=True, timeout=3,
        )
        commits = []
        for line in result.stdout.strip().splitlines():
            parts = line.split(" ", 1)
            if len(parts) == 2:
                commits.append((parts[0], parts[1]))
    except Exception:
        commits = []


load_commits()


ROW_H = 44.0


def _render_row(ctx, item, i, x, y, w, is_sel):
    hash_str, subject = item
    if is_sel:
        ctx.rect(x, y, w, ROW_H, fill=THEME.highlight)

    text_color = THEME.fg if is_sel else THEME.muted
    text_y = y + (ROW_H - BODY) / 2

    ctx.text(
        x + PAD, text_y, subject,
        size=BODY, color=text_color, bold=is_sel,
    )
    # Hash on the right (monospace, dimmed), host measures exact width.
    ctx.text_right(
        x + w - PAD, text_y + (BODY - MONO_SMALL) / 2, hash_str,
        size=MONO_SMALL, color=THEME.muted, monospace=True,
    )


@app.on_render
def render(ctx):
    ctx.rect(0, 0, ctx.width, ctx.height, fill=THEME.bg)

    if not commits:
        ctx.header("git log  ·  0 commits")
        ctx.empty_state(
            "No commits found",
            "Not a git repository?",
        )
        ctx.status_bar([("r", "refresh"), ("⌘W", "close")])
        return

    ctx.header(f"git log  ·  {len(commits)} commit{'s' if len(commits) != 1 else ''}")

    ctx.scrollable_list(
        list_id="commits",
        items=commits,
        selected=selected,
        row_height=ROW_H,
        render_row=_render_row,
    )

    ctx.status_bar(
        [
            ("j/k", "navigate"),
            ("Enter", "show"),
            ("r", "refresh"),
            ("⌘W", "close"),
        ],
    )


@app.on_key
def on_key(key, mods, emit):
    global selected
    # Plexi sends printable characters via Event::Text as lowercase (e.g. "j", "r").
    # Control/navigation keys come via Event::Key as PascalCase (e.g. "ArrowDown", "Enter").
    if key in ("j", "ArrowDown"):
        if commits:
            selected = min(selected + 1, len(commits) - 1)
    elif key in ("k", "ArrowUp"):
        selected = max(selected - 1, 0)
    elif key == "Enter" and commits:
        hash_str, _ = commits[selected]
        emit.run_in_terminal(f"git show {hash_str}")
    elif key == "r":
        load_commits()
        selected = 0


@app.on_command
def on_command(text, emit):
    # Allow typing a hash or index directly in the command bar
    text = text.strip()
    if text.isdigit():
        idx = int(text)
        if 0 <= idx < len(commits):
            emit.run_in_terminal(f"git show {commits[idx][0]}")
    elif text == "r":
        load_commits()


app.run()
