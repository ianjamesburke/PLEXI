{
  "name": "Wikipedia",
  "version": "1.0.0",
  "description": "The free encyclopedia — search articles and read summaries",
  "icon": "https://en.wikipedia.org/static/favicon/wikipedia.ico",
  "display": "standalone",
  "permissions": ["network"],
  "endpoint": "wss://en.wikipedia.org/.well-known/plexi-ws",
