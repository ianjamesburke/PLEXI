// Plexi App Platform — WIT Interface Definitions
// Component Model 0.2 / WASI 0.2
// wit-bindgen >= 0.20, wasm-tools >= 1.0
//
// This file is the authoritative contract between the Plexi host and any WASM
// app component. Three worlds are defined:
//
//   plexi-app        — standard apps (UI + effects + pipes)
//   plexi-gpu-app    — apps that need direct GPU render/compute pipelines
//   plexi-audio-app  — apps that need a real-time audio callback
//
// All three share the same lifecycle, state, log, and pipe imports.
// GPU and audio apps export additional interfaces the host calls.
//
// Arena-based UINode tree: every node is stored in a flat list referenced by
// u32 ID, breaking recursive type constraints while enabling O(n) structural
// diffing in the host.

package plexi:platform@0.2.0;


// ─── Shared Types ─────────────────────────────────────────────────────────────

interface types {

    // ── Geometry / color ─────────────────────────────────────────────────────

    record size { width: f32, height: f32 }
    record point { x: f32, y: f32 }
    record color { r: u8, g: u8, b: u8, a: u8 }

    // ── Input events ─────────────────────────────────────────────────────────

    record modifiers { ctrl: bool, shift: bool, alt: bool, meta: bool }

    record key-event {
        key: string,
        modifiers: modifiers,
        pressed: bool,
    }

    record mouse-event {
        position: point,
        button: option<mouse-button>,
        pressed: bool,
        scroll-delta: option<point>,
    }

    enum mouse-button { left, right, middle }

    record ui-action-event {
        handler-id: string,
    }

    record ui-value-change-event {
        handler-id: string,
        value: string,
    }

    record http-response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    record ai-message {
        role: string,
        content: string,
    }

    record ai-stream-chunk-event {
        request-id: string,
        delta: string,
        reasoning: option<string>,
        done: bool,
    }

    record ai-response-event {
        request-id: string,
        content: option<string>,
        tokens-in: u32,
        tokens-out: u32,
        error: option<string>,
    }

    record system-stats {
        cpu-usage-pct: f32,
        memory-used-bytes: u64,
        memory-total-bytes: u64,
        disk-read-bps: u64,
        disk-write-bps: u64,
        net-rx-bps: u64,
        net-tx-bps: u64,
        uptime-secs: u64,
        load-avg-one-min: f32,
    }

    // Surface events from the host after allocating / resizing a GPU texture.
    record surface-event {
        // Opaque wgpu texture handle. Pass to gpu::create-surface-view.
        texture-handle: u64,
        width: u32,
        height: u32,
    }

    // Pipe events — matches existing TypedPipeRegistry semantics.
    record pipe-message-event {
        handle: u32,
        payload: pipe-payload,
    }

    variant pipe-payload {
        binary(list<u8>),
        json(string),
    }

    variant input-event {
        // User input
        key(key-event),
        mouse(mouse-event),
        ui-action(ui-action-event),
        ui-value-change(ui-value-change-event),
        resize(size),
        focus-gained,
        focus-lost,

        // Timer
        timer-fired(u32),

        // Effect results
        system-stats-result(system-stats),
        file-read-result(result<list<u8>, string>),
        file-write-result(result<_, string>),
        http-response(http-response),
        ai-stream-chunk(ai-stream-chunk-event),
        ai-response(ai-response-event),
        declare-event-streams-result(result<list<string>, string>),
        emit-event-result(result<u64, string>),

        // GPU surface lifecycle
        surface-ready(surface-event),
        surface-resized(surface-event),

        // Typed pipe events
        pipe-message(pipe-message-event),
        pipe-peer-connected(u32),
        pipe-closed(u32),
        pipe-error(tuple<u32, string>),

        // Capability
        capability-granted(string),
        capability-denied(string),

        // Payment
        payment-complete,
        payment-failed(string),
    }

    // ── Effects ───────────────────────────────────────────────────────────────

    record file-read-effect { path: string }
    record file-write-effect { path: string, content: list<u8> }

    record http-fetch-effect {
        url: string,
        method: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
    }

    record ai-query-effect {
        request-id: string,
        model-tier: string,
        system: string,
        messages: list<ai-message>,
    }

    record event-stream-decl {
        name: string,
        schema-json: string,
        description: option<string>,
    }

    record declare-event-streams-effect {
        streams: list<event-stream-decl>,
    }

    record emit-event-effect {
        event: string,
        actor: string,
        actor-id: option<string>,
        caused-by: option<string>,
        summary: string,
        resource-id: string,
        resource-scope: option<string>,
        revision-after: string,
        payload-json: option<string>,
        state-ref: option<string>,
        revision-before: option<string>,
        rollback-token: option<string>,
        changed-resources: list<string>,
        suggested-trigger: option<string>,
    }

    record timer-effect {
        id: u32,
        delay-ms: u32,
        repeat: bool,
    }

    variant effect {
        file-read(file-read-effect),
        file-write(file-write-effect),
        http-fetch(http-fetch-effect),
        ai-query(ai-query-effect),
        declare-event-streams(declare-event-streams-effect),
        emit-event(emit-event-effect),
        set-timer(timer-effect),
        cancel-timer(u32),
        get-system-stats,
        set-title(string),
        set-status(string),
        close-self,
        request-capability(string),
    }

    // ── UI node tree (arena — avoids WIT recursive types) ─────────────────────

    type node-id = u32;

    enum alignment { start, center, end, stretch }
    enum button-style { primary, secondary, danger, ghost }
    enum badge-color { accent, success, warning, danger, neutral }

    record text-node {
        text: string,
        size: option<f32>,
        bold: bool,
        color: option<color>,
        truncate: bool,
        align: alignment,
    }

    record button-node {
        label: string,
        on-click: string,
        style: button-style,
        disabled: bool,
    }

    record text-input-node {
        value: string,
        placeholder: string,
        on-change: string,
        on-submit: string,
        password: bool,
    }

    record row-node     { children: list<node-id>, gap: f32, align: alignment, grow: bool }
    record column-node  { children: list<node-id>, gap: f32, align: alignment, grow: bool }
    record scroll-node  { child: node-id, horizontal: bool }
    record padding-node { child: node-id, top: f32, right: f32, bottom: f32, left: f32 }
    record list-node    { items: list<node-id>, selected: option<u32>, on-select: option<string> }

    record progress-bar-node {
        value: f32,
        max: f32,
        color: option<color>,
        label: option<string>,
    }

    record badge-node { text: string, color: badge-color }

    // surface-node requests a GPU texture region.
    // texture-handle is None until the host sends a surface-ready event.
    // Once set, the GPU interface can be used to issue draw/compute commands
    // targeting this texture — no pixel buffer copy required.
    record surface-node {
        width: u32,
        height: u32,
        texture-handle: option<u64>,
    }

    variant ui-node-data {
        empty,
        text(text-node),
        button(button-node),
        text-input(text-input-node),
        row(row-node),
        column(column-node),
        progress-bar(progress-bar-node),
        badge(badge-node),
        list-view(list-node),
        scroll(scroll-node),
        padding(padding-node),
        divider,
        space(f32),
        surface(surface-node),
    }

    record indexed-node {
        id: node-id,
        key: string,
        data: ui-node-data,
    }

    record ui-tree {
        root: node-id,
        nodes: list<indexed-node>,
    }

    record state-snapshot {
        entries: list<tuple<string, list<u8>>>,
    }
}


// ─── Host Interface: State ────────────────────────────────────────────────────

interface host-state {
    use types.{ state-snapshot };

    get: func(key: string) -> option<list<u8>>;
    set: func(key: string, value: list<u8>) -> result<_, string>;
    delete: func(key: string) -> result<_, string>;
    list-prefix: func(prefix: string) -> list<string>;
    snapshot: func() -> state-snapshot;
}


// ─── Host Interface: Logging ──────────────────────────────────────────────────

interface host-log {
    debug: func(msg: string);
    info: func(msg: string);
    warn: func(msg: string);
    error: func(msg: string);
}


// ─── Host Interface: GPU (WebGPU subset) ──────────────────────────────────────
//
// All handles are opaque u64 IDs. The host owns the actual wgpu objects.
// WGSL shaders are passed as strings; the host compiles them at
// create-render-pipeline / create-compute-pipeline time.
//
// Capability: "gpu:render" (required to import this interface).
// The surface-node texture-handle is the output target for render passes.

interface gpu {

    // ── Handles (opaque u64 IDs owned by the host) ────────────────────────────
    type buffer-handle  = u64;
    type texture-handle = u64;
    type pipeline-handle = u64;
    type bind-group-handle = u64;

    // ── Buffer usage flags ────────────────────────────────────────────────────
    flags buffer-usage {
        vertex,
        index,
        uniform,
        storage,
        copy-src,
        copy-dst,
    }

    // ── Texture format and usage ──────────────────────────────────────────────
    enum texture-format { rgba8-unorm, rgba8-srgb, bgra8-unorm, r32-float, rgba16-float }

    flags texture-usage {
        texture-binding,
        storage-binding,
        render-attachment,
        copy-src,
        copy-dst,
    }

    record texture-desc {
        width: u32,
        height: u32,
        format: texture-format,
        usage: texture-usage,
        mip-levels: u32,
    }

    // ── Pipeline descriptors ──────────────────────────────────────────────────

    record vertex-attr {
        location: u32,
        format: string,     // "float32x2", "float32x4", "uint32", etc.
        offset: u32,
    }

    record render-pipeline-desc {
        vs-entry: string,   // WGSL entry point name for vertex stage
        fs-entry: string,   // WGSL entry point name for fragment stage
        vertex-stride: u32,
        attrs: list<vertex-attr>,
        output-format: texture-format,
        blend-alpha: bool,
    }

    // ── Bind group entry ──────────────────────────────────────────────────────

    variant binding-resource {
        buffer(buffer-handle),
        texture(texture-handle),
    }

    record binding-entry {
        binding: u32,
        resource-ref: binding-resource,
    }

    // ── Render pass ───────────────────────────────────────────────────────────

    record draw-call {
        vertices: u32,
        instances: u32,
        first-vertex: u32,
        first-instance: u32,
    }

    record render-pass-desc {
        // Render target: the surface-node texture-handle from the host.
        target: texture-handle,
        clear-color: option<tuple<f32, f32, f32, f32>>,
        pipeline: pipeline-handle,
        vertex-buffer: option<buffer-handle>,
        index-buffer: option<buffer-handle>,
        bind-groups: list<tuple<u32, bind-group-handle>>,
        draws: list<draw-call>,
    }

    // ── Compute pass ──────────────────────────────────────────────────────────

    record compute-dispatch {
        x: u32,
        y: u32,
        z: u32,
    }

    record compute-pass-desc {
        pipeline: pipeline-handle,
        bind-groups: list<tuple<u32, bind-group-handle>>,
        dispatches: list<compute-dispatch>,
    }

    // ── Functions ─────────────────────────────────────────────────────────────

    // Create a view into the surface-node texture so it can be used as a
    // render attachment. Must be called after receiving surface-ready event.
    create-surface-view: func(handle: texture-handle) -> result<texture-handle, string>;

    // Buffers
    create-buffer: func(label: string, size: u64, usage: buffer-usage) -> result<buffer-handle, string>;
    write-buffer: func(handle: buffer-handle, offset: u64, data: list<u8>) -> result<_, string>;
    read-buffer: func(handle: buffer-handle, offset: u64, size: u64) -> result<list<u8>, string>;
    destroy-buffer: func(handle: buffer-handle);

    // Textures (in addition to surface-node textures allocated by the host)
    create-texture: func(label: string, desc: texture-desc) -> result<texture-handle, string>;
    destroy-texture: func(handle: texture-handle);

    // Pipelines — WGSL source compiled by the host at call time.
    create-render-pipeline: func(label: string, wgsl: string, desc: render-pipeline-desc) -> result<pipeline-handle, string>;
    create-compute-pipeline: func(label: string, wgsl: string, entry: string) -> result<pipeline-handle, string>;
    destroy-pipeline: func(handle: pipeline-handle);

    // Bind groups
    create-bind-group: func(pipeline: pipeline-handle, bindings: list<binding-entry>) -> result<bind-group-handle, string>;
    destroy-bind-group: func(handle: bind-group-handle);

    // Submit
    submit-render-pass: func(pass: render-pass-desc) -> result<_, string>;
    submit-compute-pass: func(pass: compute-pass-desc) -> result<_, string>;

    // Copy texture to texture (e.g. resolve MSAA, copy to read-back buffer)
    copy-texture: func(src: texture-handle, dst: texture-handle) -> result<_, string>;
}


// ─── Host Interface: Real-Time Audio Control ───────────────────────────────────
//
// Apps import this to open and close audio streams.
// Capability: "audio:rt" (required to import this interface).
//
// Once a stream is open, the host calls the app's exported
// audio-rt-process::process-output (or process-input) from its
// OS-level audio thread. Those callbacks must complete in < buffer_frames
// samples worth of time (typically < 5ms). No allocation, no locks.

interface audio-rt-control {

    enum audio-format { float32, int16 }

    record audio-config {
        sample-rate: u32,       // e.g. 44100, 48000
        channels: u32,          // 1 = mono, 2 = stereo
        buffer-frames: u32,     // frames per callback; host chooses nearest supported
        format: audio-format,
    }

    type stream-handle = u32;

    // Open an output stream. Host begins calling process-output once open.
    open-output: func(config: audio-config) -> result<stream-handle, string>;

    // Open an input stream. Host begins calling process-input once open.
    open-input: func(config: audio-config) -> result<stream-handle, string>;

    // Query actual config negotiated by the host (may differ from requested).
    stream-config: func(handle: stream-handle) -> result<audio-config, string>;

    // Pause / resume without destroying the stream.
    pause: func(handle: stream-handle) -> result<_, string>;
    resume: func(handle: stream-handle) -> result<_, string>;

    // Close and free host resources.
    close: func(handle: stream-handle) -> result<_, string>;
}


// ─── App Export: Real-Time Audio Process ──────────────────────────────────────
//
// Apps that use audio-rt-control MUST export this interface.
// The host calls these functions from its real-time audio thread.
// CONSTRAINTS:
//   - No heap allocation inside these functions.
//   - No locks, no blocking I/O, no system calls.
//   - No WIT imports called here (they may lock the wasmtime Store).
//   - Return within buffer_frames samples worth of time.
// State is passed in/out through the interleaved sample buffer and u64 state slot.

interface audio-rt-process {
    use audio-rt-control.{ stream-handle };

    // Host calls to fill an output buffer. Return value is interleaved f32
    // samples, length = buffer_frames * channels. Values clamped to [-1.0, 1.0].
    // `state` is a mutable u64 the app can use to thread minimal context
    // (e.g. phase accumulator) without heap allocation.
    process-output: func(
        handle: stream-handle,
        buffer-frames: u32,
        channels: u32,
        sample-rate: u32,
        state: u64,
    ) -> tuple<list<f32>, u64>;

    // Host calls to deliver captured input samples. `samples` is interleaved f32.
    process-input: func(
        handle: stream-handle,
        samples: list<f32>,
        channels: u32,
        sample-rate: u32,
        state: u64,
    ) -> u64;
}


// ─── Host Interface: Typed Pipes ─────────────────────────────────────────────
//
// WASM interface to the existing TypedPipeRegistry in src/host/typed_pipes.rs.
// Binary pipes: Unix socket + u32-BE length-prefixed frames + ArrayQueue ring.
// JSON pipes: metadata only, routed through the WIT event stream.
// Pipe messages arrive as input-event::pipe-message in the normal update() loop.
// Capability: "pipes:open" (required to import this interface).

interface pipes {

    type pipe-handle = u32;
    enum pipe-type { binary, json }
    enum pipe-direction { %in, out, duplex }

    // Open a pipe. For binary pipes, the host allocates a socket and starts
    // a drain thread; this mirrors TypedPipeRegistry::open_binary.
    // id must be unique within this app instance.
    open: func(
        id: string,
        kind: pipe-type,
        direction: pipe-direction,
    ) -> result<pipe-handle, string>;

    // Send a binary frame on a binary pipe. The frame is pushed to the
    // ArrayQueue ring; the drain thread writes it to the socket.
    // Returns an error if the ring is full (overrun) — app should drop the frame.
    send-binary: func(handle: pipe-handle, payload: list<u8>) -> result<_, string>;

    // Send a JSON message on a JSON pipe (routed through WIT event stream).
    send-json: func(handle: pipe-handle, json: string) -> result<_, string>;

    // Close the pipe and free host resources.
    close: func(handle: pipe-handle) -> result<_, string>;

    // Returns true if the pipe has a connected peer (binary) or a registered
    // listener (JSON). Useful before sending to avoid overrun.
    is-connected: func(handle: pipe-handle) -> bool;
}


// ─── App Export: Lifecycle ────────────────────────────────────────────────────

interface lifecycle {
    use types.{ input-event, effect, ui-tree, state-snapshot };

    init: func(state: state-snapshot, size: tuple<f32, f32>, args: list<string>) -> list<effect>;
    update: func(event: input-event) -> list<effect>;
    // Pure — must not call any host imports. Host diffs output against prior tree.
    view: func() -> ui-tree;
}


// ─── Worlds ───────────────────────────────────────────────────────────────────

// Standard app — UI, effects, pipes, state.
world plexi-app {
    import host-state;
    import host-log;
    import pipes;
    export lifecycle;
}

// GPU app — adds direct render/compute pipeline access.
// Declare "gpu:render" in manifest capabilities.
world plexi-gpu-app {
    import host-state;
    import host-log;
    import pipes;
    import gpu;
    export lifecycle;
}

// Audio app — adds RT audio control + process callback.
// Declare "audio:rt" in manifest capabilities.
// process-output / process-input are called by the host from its RT thread.
world plexi-audio-app {
    import host-state;
    import host-log;
    import pipes;
    import audio-rt-control;
    export lifecycle;
    export audio-rt-process;
}

// Full — GPU + audio + pipes. For DAW, video editors, games with audio.
world plexi-full-app {
    import host-state;
    import host-log;
    import pipes;
    import gpu;
    import audio-rt-control;
    export lifecycle;
    export audio-rt-process;
}
