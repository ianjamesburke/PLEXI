[
  {
    "stage": "preflight",
    "description": "verify binary installed and no host already running",
    "argv": [
      "plexi-e2e",
      "host",
      "status",
      "--json"
    ]
  },
  {
    "stage": "boot",
    "description": "start isolated host with seeded workspace pane(s)",
    "argv": [
      "plexi-e2e",
      "host",
      "start",
      "--timeout-secs",
      "30",
      "--pane",
      "cwd=/Users/ianburke/plexi-e2e-apps/log-viewer"
    ]
  },
  {
    "stage": "boot",
    "description": "poll readiness",
    "argv": [
      "plexi-e2e",
      "host",
      "status",
      "--json"
    ]
  },
  {
    "stage": "drive",
    "description": "list panes to find the workspace pane",
    "argv": [
      "plexi-e2e",
      "pane",
      "list"
    ]
  },
  {
    "stage": "drive",
    "description": "launch child agent (c) in workspace pane",
    "argv": [
      "plexi-e2e",
      "pane",
      "send",
      "<workspace_pane_id>",
      "c\\n"
    ]
  },
  {
    "stage": "drive",
    "description": "deliver the initial user prompt to the child",
    "argv": [
      "plexi-e2e",
      "pane",
      "send",
      "<child_pane_id>",
      "<prompt>\\n"
    ]
  },
  {
    "stage": "observe",
    "description": "round 1: capture child transcript",
    "argv": [
      "plexi-e2e",
      "pane",
      "capture",
      "<child_pane_id>",
      "--lines",
      "80"
    ]
  },
  {
    "stage": "observe",
    "description": "round 1: tail host log for ground truth",
    "argv": [
      "tail",
      "-100",
      "/Users/ianburke/.plexi-e2e/plexi.log"
    ]
  },
  {
    "stage": "observe",
    "description": "round 2: capture child transcript",
    "argv": [
      "plexi-e2e",
      "pane",
      "capture",
      "<child_pane_id>",
      "--lines",
      "80"
    ]
  },
  {
    "stage": "observe",
    "description": "round 2: tail host log for ground truth",
    "argv": [
      "tail",
      "-100",
      "/Users/ianburke/.plexi-e2e/plexi.log"
    ]
  },
  {
    "stage": "observe",
    "description": "round 3: capture child transcript",
    "argv": [
      "plexi-e2e",
      "pane",
      "capture",
      "<child_pane_id>",
      "--lines",
      "80"
    ]
  },
  {
    "stage": "observe",
    "description": "round 3: tail host log for ground truth",
    "argv": [
      "tail",
      "-100",
      "/Users/ianburke/.plexi-e2e/plexi.log"
    ]
  },
