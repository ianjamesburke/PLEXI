# moss-counter.moss - Moss proof-of-concept app for Plexi alpha
#
# Open directly:
# plexi-alpha app open apps/dev/moss-counter.moss
#
# Render directly:
# plexi-alpha app render apps/dev/moss-counter.moss --state apps/dev/moss-counter.state.json --png --output /tmp/moss-counter.png

use plexi/ui as ui

app_title = "Counter"
initial_count = 0

fn main
    count = initial_count

    state =
        count: count

    footer_entries =
        - ui.footer_key("+", "increment")
        - ui.footer_key("r", "reset")

    children =
        - ui.app_bar(app_title)
        - ui.state_label("Count: ", "count")
        - ui.button("increment", "Increment")
        - ui.spacer(true)
        - ui.footer_keys(footer_entries)

    output ui.app(app_title, state, ui.column(children))
