---
import Logo from './Logo.astro';
import { publishedPosts } from '../lib/blog';

// Blog joins the nav by itself once a post is published.
const hasPosts = (await publishedPosts()).length > 0;
const links = [
  { href: '/product', label: 'Product' },
  { href: '/plugins', label: 'Plugins' },
  { href: '/docs', label: 'Docs' },
  { href: '/changelog', label: 'Changelog' },
  ...(hasPosts ? [{ href: '/blog', label: 'Blog' }] : []),
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---
<nav class="top" aria-label="Main navigation">
  <div class="wrap row">
    <a class="brand" href="/" aria-label="Plexi home">
      <Logo ariaLabel="" />
      plexi
    </a>
    <div class="links">
      {links.map(l => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </div>
    <div class="cta">
      <a class="btn nav-download" href="/download">Download</a>
    </div>
    <button class="mobile-menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    {links.map(l => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
    <a class="btn lg" href="/download">Download for Mac</a>
  </div>
</nav>

<style>
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 12px;
    margin-right: -12px;
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
  }
  .mobile-menu-btn .bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--fg);
    transition: transform 200ms var(--ease-out);
  }
  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: 4px var(--gutter) 24px;
    border-top: 1px solid var(--border);
  }
  .mobile-menu a:not(.btn) {
    color: var(--fg);
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -.02em;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .mobile-menu a[aria-current="page"]:not(.btn) { color: var(--accent-light); }
  .mobile-menu .btn { margin-top: 20px; }

  @media (max-width: 980px) {
    .mobile-menu-btn { display: flex; }
    nav.top .cta { display: none; }
    nav.top.open .mobile-menu { display: flex; }
    nav.top.open .mobile-menu-btn .bar:first-child { transform: translateY(4px) rotate(45deg); }
    nav.top.open .mobile-menu-btn .bar:last-child { transform: translateY(-4px) rotate(-45deg); }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.mobile-menu-btn');
  const nav = document.querySelector<HTMLElement>('nav.top');
  const setOpen = (open: boolean) => {
    nav?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
  };
  btn?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
  nav?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav.classList.contains('open')) {
      setOpen(false);
      btn?.focus();
    }
  });
  document.querySelectorAll('.mobile-menu a').forEach(a => a.addEventListener('click', () => setOpen(false)));
</script>
