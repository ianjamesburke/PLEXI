---
import Logo from './Logo.astro';
---
<nav class="top">
  <div class="wrap row">
    <a class="brand" href="/">
      <Logo />
      plexi
    </a>
    <div class="links">
      <a href="/#product">Product</a>
      <a href="/apps">Apps</a>
      <a href="/blog">Blog</a>
      <a href="/docs">Docs</a>
      <a href="/support">Support</a>
    </div>
    <button class="mobile-menu-btn" aria-label="Menu" aria-expanded="false">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
  <div class="mobile-menu">
    <a href="/#product">Product</a>
    <a href="/apps">Apps</a>
    <a href="/blog">Blog</a>
    <a href="/docs">Docs</a>
    <a href="/support">Support</a>
    <a class="btn" href="/download">Download</a>
  </div>
</nav>

<style>
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    flex-direction: column;
    gap: 5px;
  }
  .mobile-menu-btn .bar {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--fg-2);
    transition: transform 200ms, opacity 200ms;
  }
  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: 0 32px 24px;
    gap: 0;
  }
  .mobile-menu a {
    color: var(--fg-2);
    font-size: 15px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: color 150ms;
  }
  .mobile-menu a:last-child { border-bottom: none; margin-top: 8px; }
  .mobile-menu a:hover { color: var(--fg-1); }

  @media (max-width: 980px) {
    .mobile-menu-btn { display: flex; }
    nav.top.open .mobile-menu { display: flex; }
    nav.top.open .mobile-menu-btn .bar:first-child { transform: rotate(45deg) translate(2px, 2px); }
    nav.top.open .mobile-menu-btn .bar:last-child { transform: rotate(-45deg) translate(2px, -2px); }
  }
</style>

<script>
  const btn = document.querySelector('.mobile-menu-btn');
  const nav = document.querySelector('nav.top');
  btn?.addEventListener('click', () => {
    nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', nav?.classList.contains('open') ? 'true' : 'false');
  });
  document.querySelectorAll('.mobile-menu a').forEach(a => {
    a.addEventListener('click', () => {
      nav?.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
