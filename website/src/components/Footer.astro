---
import Logo from './Logo.astro';
import { release } from '../lib/release';

const columns = [
  { title: 'Product', links: [
    { href: '/product', label: 'Tour' },
    { href: '/plugins', label: 'Plugins and views' },
    { href: '/download', label: 'Download' },
    { href: '/changelog', label: 'Changelog' },
  ] },
  { title: 'Docs', links: [
    { href: '/docs', label: 'Start here' },
    { href: '/docs/getting-started', label: 'Install and set up' },
    { href: '/docs/cli', label: 'CLI reference' },
    { href: '/docs/sdk', label: 'Python SDK' },
  ] },
  { title: 'Project', links: [
    { href: release.repo, label: 'GitHub' },
    { href: '/blog', label: 'Blog' },
    { href: '/rss.xml', label: 'RSS' },
    { href: '/support', label: 'Fund Plexi' },
  ] },
  { title: 'Legal', links: [
    { href: '/legal/terms', label: 'Terms' },
    { href: '/legal/privacy', label: 'Privacy' },
    { href: '/legal/refunds', label: 'Refunds' },
    { href: '/legal/dmca', label: 'DMCA and abuse' },
  ] },
];
---
<footer class="site-footer">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <a class="foot-logo" href="/" aria-label="Plexi home"><Logo size={26} ariaLabel="" /><span>plexi</span></a>
      <p>An agent operating system for developers who work with coding agents.</p>
      <p class="foot-status">Apple Silicon Mac today. Windows and Linux are coming soon.</p>
    </div>
    {columns.map(col => (
      <nav class="foot-col" aria-label={col.title}>
        <h2>{col.title}</h2>
        <ul>{col.links.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="wrap foot-base">
    <span>© 2026 Plexi. The last app you'll ever need.</span>
    <span>Beta {release.beta.version}. Builds are self-signed and not notarized.</span>
  </div>
</footer>

<style>
  .site-footer { position: relative; z-index: 1; padding: 72px 0 36px; border-top: 1px solid var(--border); background: rgba(8, 9, 11, 0.72); color: var(--fg-2); font-size: 15px; }
  .foot-grid { display: grid; grid-template-columns: minmax(240px, 1.6fr) repeat(4, minmax(0, 1fr)); gap: 48px 32px; }
  .foot-logo { display: inline-flex; align-items: center; gap: 10px; color: var(--fg); font-size: 22px; font-weight: 650; margin-bottom: 18px; }
  .foot-brand p { max-width: 34ch; line-height: 1.5; }
  .foot-status { margin-top: 12px; font: 12px/1.6 var(--mono); }
  .foot-col h2 { font: 700 11px/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--fg); margin-bottom: 14px; }
  .foot-col ul { list-style: none; display: grid; gap: 2px; }
  .foot-col a { display: inline-block; padding: 6px 0; transition: color 150ms; }
  .foot-col a:hover { color: var(--accent-light); }
  .foot-base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--border); font: 12px/1.6 var(--mono); }
  @media (max-width: 980px) {
    .foot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .foot-brand { grid-column: 1 / -1; }
  }
</style>
