---
/** A shell command with a copy button. `label` names the command for screen readers. */
interface Props { cmd: string; label?: string }
const { cmd, label = 'command' } = Astro.props;
---
<div class="copy-cmd">
  <code tabindex="0">{cmd}</code>
  <button type="button" data-copy={cmd} aria-label={`Copy ${label}`}>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" stroke="currentColor" stroke-width="1.5" /><path d="M10.5 2.5h-8v8" stroke="currentColor" stroke-width="1.5" /></svg>
    <span data-copy-label>Copy</span>
  </button>
</div>

<style>
  .copy-cmd { display: flex; align-items: stretch; background: var(--bg-2); border: 1px solid var(--border-2); min-width: 0; }
  code { flex: 1; min-width: 0; padding: 16px 18px; overflow-x: auto; white-space: nowrap; font: 15px/1.5 var(--mono); color: var(--fg); scrollbar-width: thin; }
  button { display: inline-flex; align-items: center; gap: 8px; flex: none; padding: 0 18px; min-width: 96px; justify-content: center; border: 0; border-left: 1px solid var(--border-2); background: var(--bg-3); color: var(--fg); font: 650 12px var(--mono); cursor: pointer; transition: background-color 150ms, color 150ms; }
  button:hover { background: var(--accent-light); color: var(--bg); }
  button[data-state="copied"] { background: var(--good); color: var(--bg); }
  button[data-state="failed"] { background: var(--warn); color: var(--bg); }
  @media (max-width: 520px) {
    .copy-cmd { flex-direction: column; }
    code { font-size: 13px; }
    button { border-left: 0; border-top: 1px solid var(--border-2); min-height: 44px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    let reset: ReturnType<typeof setTimeout>;
    const label = btn.querySelector('[data-copy-label]');
    const show = (state: 'copied' | 'failed', text: string) => {
      clearTimeout(reset);
      btn.dataset.state = state;
      if (label) label.textContent = text;
      reset = setTimeout(() => {
        delete btn.dataset.state;
        if (label) label.textContent = 'Copy';
      }, 2000);
    };
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        show('copied', 'Copied');
      } catch (error) {
        console.error('copy command: clipboard write failed', error);
        show('failed', 'Select it');
      }
    });
  });
</script>
