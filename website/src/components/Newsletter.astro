---
interface Props {
  compact?: boolean;
  blog?: boolean;
}
const { compact = false, blog = false } = Astro.props;
const headline = blog
  ? 'Get an email when I write something.'
  : compact
  ? 'Get an email when a new version ships.'
  : 'Follow the build.';
const sub = blog
  ? 'One email per post.'
  : 'New releases and notes from the build.';
const showSub = !compact;
const formId = blog ? 'newsletter-form-blog' : compact ? 'newsletter-form-compact' : 'newsletter-form';
---
<section class={`newsletter ${compact ? 'compact' : ''} ${blog ? 'blog' : ''}`}>
  <div class="wrap">
    <div class="nl-inner">
      <div class="nl-copy">
        <h2 class="nl-headline">{headline}</h2>
        {showSub && (
          <p class="nl-sub">{sub}</p>
        )}
      </div>
      <div class="nl-signup">
        <form id={formId} class="nl-form" novalidate>
          <input
            type="email"
            name="email"
            aria-label="Email address"
            placeholder="you@example.com"
            required
            autocomplete="email"
            class="nl-input"
          />
          <button type="submit" class="btn nl-btn">Subscribe</button>
        </form>
        <div class="nl-message" data-form-id={formId} aria-live="polite"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter {
    padding: 76px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--bg-2);
  }
  .newsletter.compact {
    padding: 48px 0;
  }
  .newsletter.blog {
    padding: 64px 0 80px;
  }
  .nl-inner {
    max-width: 980px;
    text-align: left;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(320px, 0.85fr);
    gap: 34px;
    align-items: center;
  }
  .nl-headline {
    font-size: var(--text-title);
    line-height: 1.12;
    letter-spacing: -.03em;
    font-weight: 700;
    color: var(--fg);
    margin-bottom: 10px;
  }
  .newsletter.compact .nl-headline {
    font-size: 24px;
    margin-bottom: 0;
  }
  .nl-sub {
    color: var(--fg-2);
    font-size: 16px;
    line-height: 1.5;
  }
  .nl-signup {
    display: grid;
    gap: 10px;
  }
  .nl-form {
    display: flex;
    gap: 10px;
    align-items: stretch;
    justify-content: center;
    flex-wrap: wrap;
  }
  .nl-input {
    flex: 1;
    min-width: 0;
    max-width: none;
    padding: 12px 14px;
    font-family: var(--mono);
    font-size: 16px;
    min-height: 44px;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-1);
    transition: border-color 150ms, box-shadow 150ms;
  }
  .nl-input::placeholder { color: var(--fg-4); }
  .nl-input:focus-visible { border-color: var(--accent-light); outline-offset: 2px; }
  .nl-btn { white-space: nowrap; }
  .nl-message {
    font-size: 13px;
    min-height: 16px;
    color: var(--fg-3);
  }
  .nl-message.success { color: var(--good); }
  .nl-message.error { color: var(--warn); }
  .nl-form.hidden { display: none; }

  @media (max-width: 760px) {
    .nl-headline { font-size: 22px; }
    .nl-inner { grid-template-columns: 1fr; gap: 22px; }
    .nl-form { flex-direction: column; }
    .nl-input { max-width: none; min-width: 0; width: 100%; }
  }
</style>

<script is:inline define:vars={{ formId }}>
  (function () {
    const form = document.getElementById(formId);
    if (!form) return;
    const message = document.querySelector(`[data-form-id="${formId}"]`);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      message.textContent = '';
      message.className = 'nl-message';

      const data = new FormData(form);
      const email = (data.get('email') || '').toString().trim();
      if (!email || !email.includes('@')) {
        message.textContent = 'Please enter a valid email address.';
        message.className = 'nl-message error';
        return;
      }

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }
        form.classList.add('hidden');
        message.textContent = "Thanks. You're on the list.";
        message.className = 'nl-message success';
      } catch (err) {
        console.error('newsletter: subscribe request failed', err);
        message.textContent = "Couldn't reach the server. Please try again in a moment.";
        message.className = 'nl-message error';
      }
    });
  })();
</script>
