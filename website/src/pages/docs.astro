---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Docs — Plexi" description="Plexi documentation. Coming soon.">
  <section class="docs-holding">
    <div class="wrap">
      <p class="quote">Docs are <span class="glow">incoming</span>.</p>
      <p class="sub">I'm writing them as I build. Check back soon, or follow along on the blog.</p>
      <p class="sub" style="opacity: 0.4; font-size: 12px;">Served from the PLEXI repo.</p>
      <div class="links">
        <a class="sponsor-link" href="/">← Back home</a>
        <a class="sponsor-link" href="/blog">Read the blog →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .docs-holding {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 0;
  }
  .docs-holding .quote {
    font-size: 36px;
    line-height: 1.35;
    letter-spacing: -0.015em;
    font-weight: 500;
    max-width: 28ch;
    margin: 0 auto 32px;
    color: var(--fg);
    font-family: var(--mono);
  }
  .docs-holding .quote .glow { color: var(--accent-light); }
  .docs-holding .sub {
    color: var(--fg-3);
    font-size: 14px;
    max-width: 58ch;
    margin: 0 auto 32px;
    line-height: 1.7;
  }
  .docs-holding .links {
    display: inline-flex;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: center;
  }
  @media (max-width: 980px) {
    .docs-holding .quote { font-size: 26px; }
  }
</style>
