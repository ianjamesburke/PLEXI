---
import Layout from '../../layouts/Layout.astro';
import { docsNav } from '../../lib/docsNav';
import { CURRENT_VERSION } from '../../lib/version';
---
<Layout title="Docs — Plexi" description="Plexi documentation.">
  <section class="docs-index">
    <div class="wrap">
      <header class="index-header">
        <h1>Documentation</h1>
        <p class="version-note">current version: <span class="v">{CURRENT_VERSION}</span></p>
      </header>
      <div class="sections">
        {docsNav.map(group => (
          <div class="section-block">
            <span class="section-label">{group.section}</span>
            <ul>
              {group.items.map(item => (
                <li>
                  <a href={`/docs/${item.slug}`}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .docs-index {
    padding: 80px 0 120px;
    min-height: 70vh;
  }
  .index-header {
    margin-bottom: 64px;
  }
  .index-header h1 {
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  .version-note {
    font-size: 13px;
    color: var(--fg-3);
  }
  .version-note .v {
    color: var(--good);
  }
  .sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 40px;
  }
  .section-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .section-label {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-4);
    font-weight: 600;
  }
  .section-block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .section-block ul li a {
    font-size: 14px;
    color: var(--fg-2);
    padding: 5px 0;
    display: block;
    border-bottom: 1px solid transparent;
    transition: color 150ms;
  }
  .section-block ul li a:hover {
    color: var(--accent-light);
  }
  @media (max-width: 980px) {
    .docs-index { padding: 60px 0 80px; }
    .index-header h1 { font-size: 30px; }
  }
</style>
