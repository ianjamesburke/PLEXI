---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Arrow from '../components/Arrow.astro';
import Newsletter from '../components/Newsletter.astro';
import { release } from '../lib/release';

const ALPHA_CMD = 'curl -fsSL https://plexiapp.com/install | bash -s -- --channel alpha';
const SOURCE_CMD = 'scripts/install.sh --from-source alpha';
---
<Layout
  title="Download | Plexi"
  description={`Install Plexi on an Apple Silicon Mac with one command. Beta ${release.beta.label}. Builds are self-signed and not notarized. Windows and Linux are coming soon.`}
>
  <PageHead title="Install Plexi." lede="For Apple Silicon Macs." />

  <section class="wrap install" aria-labelledby="install-title">
    <div class="install-main">
      <h2 class="title" id="install-title">Paste this in a terminal</h2>
      <CopyCommand cmd={release.installBeta} label="install command" />
      <p class="under">Installs <a class="text-link" href={release.beta.url}>Beta {release.beta.label}</a> for {release.beta.platform}.</p>

      <dl class="facts">
        <div><dt>Needs</dt><dd><code class="inline">bash</code>, <code class="inline">curl</code>, <code class="inline">tar</code> and <code class="inline">shasum</code>. All come with macOS.</dd></div>
        <div><dt>Does</dt><dd>Downloads the release archive, verifies its SHA-256 checksum and installs into directories you own.</dd></div>
        <div><dt>Then</dt><dd>Open Plexi. The beta's launcher is <code class="inline">plexi-beta</code>; inside a Plexi pane, plain <code class="inline">plexi</code> runs the build that pane belongs to. <code class="inline">plexi --help</code> lists the commands and <code class="inline">plexi ai onboard</code> walks through AI setup, which you can skip.</dd></div>
        <div><dt>Update</dt><dd><code class="inline">plexi update</code> moves to the newest build on your channel. <code class="inline">plexi update --rollback</code> restores the previous one.</dd></div>
        <div><dt>Remove</dt><dd><code class="inline">plexi uninstall</code> removes the package and its launchers. It keeps your data unless you pass <code class="inline">--delete-data</code>.</dd></div>
      </dl>
      <a class="link-arrow" href="/docs/getting-started">First steps after install <Arrow /></a>
    </div>
  </section>

  <section class="wrap split" id="trust" aria-labelledby="trust-title">
    <h2 class="h2" id="trust-title">Before you open it.</h2>
    <div class="trust-body">
      <p class="lead">Plexi builds are self-signed and not notarized by Apple. macOS will warn you the first time you open one.</p>
      <p class="muted"><a class="text-link" href={release.unsignedGuide}>How to open the build</a>.</p>
      <p class="muted">To build it yourself, clone the repository and run the source install. It needs Rust, just, uv and Python 3.11.</p>
      <CopyCommand cmd={SOURCE_CMD} label="source install command" />
      <p class="muted">Plexi is pre-1.0 beta software. Commands, config keys and the plugin API can change between releases, and the permission system is still being hardened. Install only plugins you wrote or trust.</p>
    </div>
  </section>

  <section class="wrap split" id="channels" aria-labelledby="channels-title">
    <h2 class="h2" id="channels-title">Channels.</h2>
    <div>
      <dl class="facts">
        <div><dt>Beta</dt><dd><strong>{release.beta.tag}.</strong> The current build. The command above installs it.</dd></div>
        <div><dt>Alpha</dt><dd><strong>Moves fast and can break.</strong> For following development closely.</dd></div>
        <div><dt>Stable</dt><dd><strong>{release.stable.tag}.</strong> Published before the 0.4 line. A new stable comes after {release.next}.</dd></div>
      </dl>
      <div class="alt-cmd">
        <p>Alpha channel</p>
        <CopyCommand cmd={ALPHA_CMD} label="alpha install command" />
      </div>
      <p class="under">Each channel installs separately and keeps its own data. Every published build is on the <a class="text-link" href={release.releases}>releases page</a>.</p>
    </div>
  </section>

  <section class="wrap split" id="platforms" aria-labelledby="platforms-title">
    <h2 class="h2" id="platforms-title">Other platforms.</h2>
    <dl class="facts platforms">
      <div><dt>Windows</dt><dd>Coming soon.</dd></div>
      <div><dt>Linux</dt><dd>Coming soon.</dd></div>
      <div><dt>Intel Mac</dt><dd>Not available yet.</dd></div>
    </dl>
  </section>

  <Newsletter compact />
</Layout>

<style>
  .install { padding-block: clamp(48px, 6vw, 88px); }
  .install-main { max-width: 920px; }
  .install-main .title { margin-bottom: 20px; }
  .under { margin-top: 12px; color: var(--fg-2); font-size: 15px; }
  .install-main .facts { margin-top: 40px; }
  .install-main .facts > div { grid-template-columns: 100px minmax(0, 1fr); }
  .install-main .link-arrow { margin-top: 24px; }

  .trust-body { display: grid; gap: 18px; }
  .trust-body .muted { max-width: 62ch; }

  .alt-cmd { margin-top: 28px; }
  .alt-cmd p { font: 700 12px/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--fg-2); margin-bottom: 10px; }

  .platforms dd { color: var(--fg-3); }

  @media (max-width: 620px) { .install-main .facts > div { grid-template-columns: 1fr; } }
</style>
