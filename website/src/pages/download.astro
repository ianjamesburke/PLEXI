---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';

const UNIX_INSTALL_CMD = 'curl -fsSL https://plexiapp.com/install | bash';
const WINDOWS_INSTALL_CMD = 'irm https://raw.githubusercontent.com/ianjamesburke/PLEXI/alpha/scripts/install-windows.ps1 | iex';
---
<Layout title="Download Plexi" description="Install the Plexi tiling terminal host and CLI on macOS Apple Silicon, Linux x64, or Windows x64.">
  <header class="dl-hero">
    <div class="wrap">
      <h1>Install Plexi</h1>
      <p class="tagline">Install the tiling terminal host, CLI, and shell completions.</p>
    </div>
  </header>

  <section class="dl-section">
    <div class="wrap">
      <div class="install-intro">
        <p class="eyebrow">Current release channel</p>
        <h2>Choose your platform</h2>
        <p>Each command installs the current Plexi alpha release for its supported platform.</p>
      </div>

      <div class="install-list">
      <div class="install-block">
        <div class="install-heading">
          <span class="platform-mark">01</span>
          <div class="install-label">macOS <span>(Apple Silicon; Intel when published)</span></div>
        </div>
        <div class="install-cmd-row">
          <code class="install-cmd">{UNIX_INSTALL_CMD}</code>
          <button class="copy-btn" data-cmd={UNIX_INSTALL_CMD} aria-label="Copy to clipboard">
            <span class="copy-icon">&#x2398;</span>
            <span class="copy-label">Copy</span>
          </button>
        </div>
        <p class="install-note">
          Downloads the matching current macOS alpha release. Requires <code>bash</code>,
          <code>curl</code>, <code>tar</code>, and <code>shasum</code>; it does not need Rust,
          Git, or administrator access. The installer selects your architecture; Intel works when
          that release publishes its x64 archive and otherwise reports the missing asset clearly.
        </p>
      </div>

      <div class="install-block">
        <div class="install-heading">
          <span class="platform-mark">02</span>
          <div class="install-label">Linux <span>(x86_64, X11)</span></div>
        </div>
        <div class="install-cmd-row">
          <code class="install-cmd">{UNIX_INSTALL_CMD}</code>
          <button class="copy-btn" data-cmd={UNIX_INSTALL_CMD} aria-label="Copy to clipboard">
            <span class="copy-icon">&#x2398;</span>
            <span class="copy-label">Copy</span>
          </button>
        </div>
        <p class="install-note">
          Downloads the current Linux x64 alpha release. Requires <code>bash</code>,
          <code>curl</code>, <code>tar</code>, and <code>sha256sum</code> (or <code>shasum</code>).
          Plexi supports X11 sessions; Wayland is not supported. This is a download install,
          not an apt, AUR, Flatpak, AppImage, <code>.deb</code>, or <code>.rpm</code> package.
        </p>
      </div>

      <div class="install-block">
        <div class="install-heading">
          <span class="platform-mark">03</span>
          <div class="install-label">Windows <span>(x64)</span></div>
        </div>
        <div class="install-cmd-row">
          <code class="install-cmd">{WINDOWS_INSTALL_CMD}</code>
          <button class="copy-btn" data-cmd={WINDOWS_INSTALL_CMD} aria-label="Copy to clipboard">
            <span class="copy-icon">&#x2398;</span>
            <span class="copy-label">Copy</span>
          </button>
        </div>
        <p class="install-note">
          Run in Windows PowerShell 5.1 or later. It downloads the current Windows x64 alpha
          release and verifies its SHA-256 checksum; it does not build from source. Windows shell
          completions are TBD. The Unix <code>curl | bash</code> command is not a Windows installer.
        </p>
      </div>
      </div>

      <p class="install-note trust-note">
        Alpha builds are unsigned and not notarized. Before bypassing an operating-system warning,
        read the <a href="https://github.com/ianjamesburke/PLEXI/blob/alpha/docs/unsigned-install.md">unsigned-build opening guide</a>.
        From a macOS or Linux checkout, <code>scripts/install.sh --from-source alpha</code> is
        the explicit source-build path and requires Rust plus Python 3; Windows has no equivalent
        source-install script.
      </p>

    </div>
  </section>

  <Newsletter compact />
</Layout>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    let resetTimer;
    btn.addEventListener('click', async () => {
      const cmd = btn.getAttribute('data-cmd');
      if (!cmd) return;
      const label = btn.querySelector('.copy-label');
      clearTimeout(resetTimer);
      try {
        await navigator.clipboard.writeText(cmd);
        if (label) {
          label.textContent = 'Copied';
          resetTimer = setTimeout(() => { label.textContent = 'Copy'; }, 2000);
        }
      } catch {
        if (label) {
          label.textContent = 'Failed';
          resetTimer = setTimeout(() => { label.textContent = 'Copy'; }, 2000);
        }
      }
    });
  });
</script>

<style>
  .dl-hero { padding: 112px 0 32px; }
  .dl-hero h1 {
    font-size: 56px; line-height: 1.05; letter-spacing: 0;
    font-weight: 600; margin: 0 0 16px;
  }
  .dl-hero .tagline { font-size: 16px; color: var(--fg-2); max-width: 560px; }

  .dl-section { padding: 32px 0 88px; }

  .install-intro { max-width: 620px; margin-bottom: 30px; }
  .install-intro .eyebrow {
    color: var(--accent-light);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .install-intro h2 {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 8px;
  }
  .install-intro > p:last-child { color: var(--fg-2); font-size: 14px; }

  .install-list { max-width: 860px; display: grid; gap: 14px; }

  .install-block {
    background: var(--bg-2);
    border: 1px solid var(--border-2);
    border-radius: 10px;
    padding: 28px 30px 30px;
    transition: border-color 150ms, transform 150ms, box-shadow 150ms;
  }
  .install-block:hover {
    border-color: var(--border-3);
    box-shadow: 0 16px 42px rgba(0, 0, 0, 0.2);
    transform: translateY(-1px);
  }
  .install-heading { display: flex; align-items: baseline; gap: 14px; margin-bottom: 14px; }
  .platform-mark {
    color: var(--accent-light);
    font-size: 11px;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .install-label {
    font-size: 14px;
    color: var(--fg-2);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }
  .install-label span { color: var(--fg-3); font-size: 13px; font-weight: 400; }

  .install-cmd-row {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg);
    border: 1px solid var(--border-2);
    border-radius: 8px;
    padding: 13px 14px 13px 16px;
    overflow-x: auto;
  }

  .install-cmd {
    flex: 1;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--fg);
    white-space: nowrap;
    user-select: all;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
    font-family: var(--mono);
    color: var(--fg-2);
    background: var(--bg-2);
    border: 1px solid var(--border-2);
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 150ms, border-color 150ms;
  }
  .copy-btn:hover {
    color: var(--fg);
    border-color: var(--fg-3);
  }

  .copy-icon { font-size: 14px; }

  .install-note {
    margin-top: 14px;
    font-size: 13px;
    color: var(--fg-3);
    line-height: 1.6;
  }

  .trust-note {
    max-width: 860px;
    border-left: 2px solid var(--accent);
    padding: 2px 0 2px 16px;
  }

  @media (max-width: 720px) {
    .dl-hero h1 { font-size: 40px; }
    .install-block { padding: 24px 20px; }
    .install-intro h2 { font-size: 24px; }
    .install-cmd-row { align-items: stretch; }
    .copy-btn { justify-content: center; }
  }

  @media (max-width: 480px) {
    .dl-hero { padding-top: 72px; }
    .install-heading { align-items: flex-start; }
    .install-label { font-size: 15px; }
    .install-label span { display: block; margin-top: 2px; }
    .install-cmd-row { flex-direction: column; gap: 10px; }
    .install-cmd { font-size: 12px; overflow-x: auto; padding-bottom: 2px; }
    .copy-btn { width: 100%; padding: 9px 12px; }
  }
</style>
