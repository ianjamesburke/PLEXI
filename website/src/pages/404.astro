---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Arrow from '../components/Arrow.astro';
---
<Layout title="Page not found | Plexi" description="This page does not exist." noindex>
  <PageHead title="Not here." lede="There is no page at this address. It may have moved when apps were renamed to plugins.">
    <a class="btn lg" href="/">Home</a>
    <a class="link-arrow" href="/docs">Docs <Arrow /></a>
    <a class="link-arrow" href="/plugins">Plugins <Arrow /></a>
    <a class="link-arrow" href="/download">Download <Arrow /></a>
  </PageHead>
  <div class="spacer"></div>
</Layout>

<style>
  .spacer { min-height: 22vh; }
</style>
