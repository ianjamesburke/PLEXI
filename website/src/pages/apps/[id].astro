---
import Layout from '../../layouts/Layout.astro';
import registry from '../../lib/registry-index.json';

// Detail pages are generated from the central registry index (new schema).
// Only `public` apps get a page; the build is self-contained (reads the local
// index stub) so it never depends on a live registry being reachable.
export async function getStaticPaths() {
  const apps = (registry.apps as any[]).filter(
    (a) => (a.visibility ?? 'private') === 'public'
  );
  return apps.map((app: any) => ({ params: { id: app.id }, props: { app } }));
}

const { app } = Astro.props;

function priceLabel(price: any): string {
  if (!price || price === 'free') return 'Free';
  if (typeof price === 'object') {
    const major = Math.floor(price.amount_cents / 100);
    const minor = String(price.amount_cents % 100).padStart(2, '0');
    const sym = price.currency?.toLowerCase() === 'usd' ? '$' : '';
    return `${sym}${major}.${minor} ${price.currency?.toUpperCase() ?? ''}`.trim();
  }
  return 'Free';
}

const sourceUrl = app.source?.startsWith('github:')
  ? `https://github.com/${app.source.slice('github:'.length)}`
  : null;
const installCmd = `plexi app install ${app.id}`;
---

<Layout title={`${app.name} — Plexi Apps`} description={app.description}>
  <div class="wrap">
    <nav class="breadcrumb">
      <a href="/">plexi</a>
      <span class="sep">/</span>
      <a href="/apps">apps</a>
      <span class="sep">/</span>
      <span class="current">{app.id}</span>
    </nav>

    <header class="app-header">
      <div class="title-row">
        <h1>{app.name}</h1>
        <span class="core-badge">{priceLabel(app.price)}</span>
        <span class="version">v{app.version}</span>
      </div>
      <p class="desc">{app.description}</p>
    </header>

    <div class="install-block" id="install-block">
      <span class="install-label">install</span>
      <span class="install-cmd">{installCmd}</span>
      <button class="copy-btn" data-cmd={installCmd}>Copy</button>
    </div>

    <div class="meta">
      {app.publisher && (
        <div class="meta-row">
          <span class="meta-label">Publisher</span>
          <span class="meta-val">@{app.publisher}</span>
        </div>
      )}
      {app.trust_label && (
        <div class="meta-row">
          <span class="meta-label">Trust</span>
          <span class="meta-val">{app.trust_label}</span>
        </div>
      )}
      {sourceUrl && (
        <div class="meta-row">
          <span class="meta-label">Source</span>
          <span class="meta-val">
            <a href={sourceUrl} target="_blank">{app.source}</a>
          </span>
        </div>
      )}
      {app.capabilities?.length > 0 && (
        <div class="meta-row">
          <span class="meta-label">Capabilities</span>
          <span class="meta-val tags">
            {app.capabilities.map((c: string) => <span class="tag">{c}</span>)}
          </span>
        </div>
      )}
    </div>

    <div class="back-row">
      <a href="/apps" class="back">← All apps</a>
    </div>
  </div>
</Layout>

<script>
  document.querySelector('.copy-btn')?.addEventListener('click', function(this: HTMLButtonElement) {
    navigator.clipboard.writeText(this.dataset.cmd!);
    this.textContent = 'Copied!';
    setTimeout(() => { this.textContent = 'Copy'; }, 1500);
  });
</script>

<style>
  .breadcrumb {
    padding: 32px 0 0;
    font-size: 13px;
    color: var(--fg-4);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .breadcrumb a { color: var(--fg-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--fg); }
  .breadcrumb .sep { color: var(--border-3); }
  .breadcrumb .current { color: var(--fg-2); }

  .app-header {
    padding: 40px 0 32px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 32px;
  }

  .title-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  h1 {
    font-size: 42px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--fg);
  }

  .core-badge {
    font-size: 12px;
    color: var(--accent-light);
    border: 1px solid var(--accent-dim);
    background: var(--accent-dim);
    padding: 2px 8px;
    border-radius: 99px;
    letter-spacing: 0.04em;
  }

  .version {
    font-size: 13px;
    color: var(--fg-4);
  }

  .desc {
    font-size: 16px;
    color: var(--fg-2);
    line-height: 1.6;
    max-width: 560px;
  }

  .install-block {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--bg-2);
    border: 1px solid var(--border-2);
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 32px;
  }

  .install-label {
    font-size: 12px;
    color: var(--fg-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .install-cmd {
    font-size: 15px;
    color: var(--good);
    flex: 1;
    letter-spacing: 0.01em;
  }

  .copy-btn {
    background: transparent;
    border: 1px solid var(--border-2);
    color: var(--fg-4);
    font-family: var(--mono);
    font-size: 12px;
    padding: 5px 12px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .copy-btn:hover { border-color: var(--border-3); color: var(--fg-2); }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
  }

  .meta-row:last-child { border-bottom: none; }

  .meta-label {
    font-size: 12px;
    color: var(--fg-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    width: 60px;
    flex-shrink: 0;
  }

  .meta-val {
    font-size: 13px;
    color: var(--fg);
  }

  .meta-val a {
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid var(--border-3);
    transition: color 0.15s, border-color 0.15s;
  }

  .meta-val a:hover { color: var(--fg); border-color: var(--fg-3); }

  .meta-val.tags { display: flex; gap: 6px; flex-wrap: wrap; }

  .tag {
    font-size: 12px;
    color: var(--fg-4);
    background: var(--bg-3);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .back-row { padding-bottom: 80px; }

  .back {
    font-size: 13px;
    color: var(--fg-4);
    text-decoration: none;
    transition: color 0.15s;
  }

  .back:hover { color: var(--fg-2); }
</style>
