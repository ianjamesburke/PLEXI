---
import Layout from '../../layouts/Layout.astro';
import Newsletter from '../../components/Newsletter.astro';
import PageHead from '../../components/PageHead.astro';
import Arrow from '../../components/Arrow.astro';
import { publishedPosts } from '../../lib/blog';

const posts = await publishedPosts();

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
---
<Layout title="Blog | Plexi" description="Notes from building Plexi.">
  <PageHead title="Blog." lede="Notes from building Plexi." compact>
    <a class="link-arrow" href="/rss.xml">RSS feed <Arrow dir="ne" /></a>
  </PageHead>
  <div class="wrap blog-body">
    {posts.length === 0 ? (
      <p class="empty">Nothing published yet. The <a class="text-link" href="/changelog">changelog</a> has what shipped in each version.</p>
    ) : (
      <div class="posts">
        {posts.map((post) => (
          <a class="post-row" href={`/blog/${post.id}/`}>
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>

  <Newsletter blog />
</Layout>

<style>
  .blog-body { padding-block: clamp(40px, 5vw, 72px) var(--space-section); }
  .empty { font-size: var(--text-lead); max-width: 40ch; line-height: 1.35; }
  .post-row { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 8px 32px; padding: 28px 0; border-bottom: 1px solid var(--border); }
  .post-row:first-child { border-top: 1px solid var(--border); }
  .post-row time { font: 13px/1.8 var(--mono); color: var(--fg-3); }
  .post-row h2 { font-size: var(--text-title); font-weight: 700; letter-spacing: -.03em; line-height: 1.12; transition: color 150ms; }
  .post-row:hover h2 { color: var(--accent-light); }
  .post-row p { margin-top: 8px; color: var(--fg-2); max-width: 64ch; }
  @media (max-width: 640px) { .post-row { grid-template-columns: minmax(0, 1fr); } }
</style>
