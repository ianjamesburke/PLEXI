---
import Layout from './Layout.astro';
import PageHead from '../components/PageHead.astro';
import Notice from '../components/Notice.astro';

interface Props {
  title: string;
  description?: string;
  lastReviewed: string;
}

const { title, description = '', lastReviewed } = Astro.props;

const legalPages = [
  { href: '/legal/terms', label: 'Terms' },
  { href: '/legal/privacy', label: 'Privacy' },
  { href: '/legal/refunds', label: 'Refunds' },
  { href: '/legal/dmca', label: 'DMCA & Abuse' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
---
<Layout title={`${title} | Plexi`} description={description}>
  <PageHead title={title} compact>
    <nav class="legal-nav" aria-label="Legal pages">
      {legalPages.map(p => (
        <a href={p.href} class="legal-nav-link" aria-current={currentPath === p.href ? 'page' : undefined}>{p.label}</a>
      ))}
    </nav>
  </PageHead>
  <article class="legal-article">
    <div class="wrap">
      <p class="reviewed">Last reviewed: {lastReviewed}</p>
      <Notice>
        <p>These are plain-language drafts written by the Plexi team, not a lawyer.
        They are under professional legal review before commercial launch. If
        anything here conflicts with what a signed agreement or applicable law
        requires, the law wins.</p>
      </Notice>

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style>
  .legal-article { padding: clamp(36px, 5vw, 64px) 0 var(--space-section); }
  .legal-article .wrap > * { max-width: 760px; }
  .reviewed { color: var(--fg-3); font: 13px/1.5 var(--mono); margin-bottom: 20px; }
  .legal-nav { display: flex; flex-wrap: wrap; gap: 4px 0; margin-inline: -12px; }
  .legal-nav-link { padding: 10px 12px; font: 12px/1.4 var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--fg-2); border-bottom: 2px solid transparent; transition: color 150ms, border-color 150ms; }
  .legal-nav-link:hover { color: var(--fg); }
  .legal-nav-link[aria-current="page"] { color: var(--fg); border-bottom-color: var(--accent-light); }

  .prose { margin-top: 40px; color: var(--fg); font-size: 16px; line-height: 1.75; }
  .prose :global(h2) { font-size: 24px; letter-spacing: -.02em; font-weight: 700; margin: 44px 0 16px; color: var(--fg); }
  .prose :global(h3) { font-size: 18px; font-weight: 700; margin: 30px 0 12px; color: var(--fg); }
  .prose :global(p) { margin-bottom: 18px; color: var(--fg-2); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 18px 22px; color: var(--fg-2); }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(strong) { color: var(--fg); font-weight: 700; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 40px 0; }
</style>
