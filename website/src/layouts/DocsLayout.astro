---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { docsNav } from '../lib/docsNav';
import { CURRENT_VERSION } from '../lib/version';

interface Props {
  title: string;
  description?: string;
  verified_version?: string;
  currentSlug?: string;
}

const { title, description = '', verified_version, currentSlug } = Astro.props;
const pageTitle = `${title} — Plexi Docs`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const isStale = verified_version && verified_version !== CURRENT_VERSION;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Plexi" />
</head>
<body>
  <Nav />
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <div class="sidebar-inner">
        <a href="/docs" class="sidebar-home">← Docs</a>
        {docsNav.map(group => (
          <div class="nav-group">
            <span class="nav-group-label">{group.section}</span>
            {group.items.map(item => (
              <a
                href={`/docs/${item.slug}`}
                class:list={['nav-item', { active: currentSlug === item.slug }]}
              >
                {item.title}
              </a>
            ))}
          </div>
        ))}
      </div>
    </aside>
    <main class="docs-main">
      <div class="docs-content">
        <header class="doc-header">
          <h1>{title}</h1>
          {verified_version && (
            <span class:list={['version-badge', { stale: isStale }]}>
              {isStale ? '⚠' : '✓'} verified v{verified_version}
              {isStale && <span class="current-hint"> (current: v{CURRENT_VERSION})</span>}
            </span>
          )}
        </header>
        <div class="prose">
          <slot />
        </div>
      </div>
    </main>
  </div>
  <Footer />
</body>
</html>

<style>
  .docs-shell {
    display: flex;
    min-height: calc(100vh - 64px);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
    gap: 0;
    position: relative;
    z-index: 1;
  }

  .docs-sidebar {
    width: 220px;
    flex-shrink: 0;
    border-right: 1px solid var(--border);
  }

  .sidebar-inner {
    position: sticky;
    top: 64px;
    padding: 40px 0 40px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sidebar-home {
    font-size: 12px;
    color: var(--fg-3);
    letter-spacing: 0.04em;
    padding: 0 0 24px;
    display: block;
    transition: color 150ms;
  }
  .sidebar-home:hover { color: var(--accent-light); }

  .nav-group {
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-group-label {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-4);
    font-weight: 600;
    padding: 0 12px 6px;
  }

  .nav-item {
    display: block;
    padding: 6px 12px;
    font-size: 13px;
    color: var(--fg-3);
    border-radius: 5px;
    transition: color 150ms, background 150ms;
  }
  .nav-item:hover { color: var(--fg); background: var(--bg-3); }
  .nav-item.active { color: var(--accent-light); background: var(--accent-dim); }

  .docs-main {
    flex: 1;
    min-width: 0;
    padding: 48px 0 48px 56px;
  }

  .docs-content {
    max-width: 680px;
  }

  .doc-header {
    margin-bottom: 40px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 16px;
  }

  .doc-header h1 {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--fg);
  }

  .version-badge {
    font-size: 11px;
    color: var(--good);
    background: rgba(52, 211, 153, 0.1);
    border: 1px solid rgba(52, 211, 153, 0.25);
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }
  .version-badge.stale {
    color: var(--warn);
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.25);
  }
  .current-hint { opacity: 0.7; }

  /* Prose */
  .prose { color: var(--fg-2); font-size: 14px; line-height: 1.8; }
  .prose h2 { font-size: 20px; letter-spacing: -0.01em; font-weight: 600; margin: 40px 0 14px; color: var(--fg); }
  .prose h3 { font-size: 15px; font-weight: 600; margin: 28px 0 10px; color: var(--fg); }
  .prose p { margin-bottom: 16px; }
  .prose a { color: var(--accent-light); border-bottom: 1px solid rgba(147, 51, 234, 0.35); transition: color 150ms, border-color 150ms; }
  .prose a:hover { color: var(--fg); border-bottom-color: var(--fg); }
  .prose ul, .prose ol { margin: 0 0 16px 22px; }
  .prose li { margin-bottom: 5px; }
  .prose li p { margin-bottom: 0; }
  .prose code { background: var(--bg-3); padding: 2px 6px; border-radius: 4px; font-size: 12.5px; color: var(--accent-light); border: 1px solid var(--border); }
  .prose pre { background: var(--bg-2); border: 1px solid var(--border-2); border-radius: 8px; padding: 16px 18px; overflow-x: auto; margin-bottom: 18px; font-size: 12.5px; line-height: 1.7; }
  .prose pre code { background: transparent; border: none; padding: 0; color: var(--fg-2); }
  .prose blockquote { border-left: 2px solid var(--accent); padding-left: 16px; color: var(--fg-3); margin: 0 0 16px; }
  .prose table { width: 100%; border-collapse: collapse; margin-bottom: 18px; font-size: 13px; }
  .prose th { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--border-2); color: var(--fg-3); font-weight: 500; letter-spacing: 0.04em; font-size: 11px; text-transform: uppercase; }
  .prose td { padding: 8px 12px; border-bottom: 1px solid var(--border); }
  .prose tr:last-child td { border-bottom: none; }

  .prose .callout {
    border: 1px solid var(--border-2);
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 18px;
    background: var(--bg-2);
    font-size: 13px;
  }

  @media (max-width: 980px) {
    .docs-shell { flex-direction: column; padding: 0 20px; gap: 0; }
    .docs-sidebar { width: 100%; border-right: none; border-bottom: 1px solid var(--border); }
    .sidebar-inner { position: static; padding: 24px 0 20px; }
    .nav-group { margin-bottom: 16px; }
    .docs-main { padding: 32px 0; }
    .doc-header h1 { font-size: 26px; }
  }
</style>
