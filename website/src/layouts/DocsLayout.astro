---
import '../styles/global.css';
import '../styles/docs.css';
import Texture from '../components/Texture.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsToc from '../components/docs/DocsToc.astro';
import DocsPager from '../components/docs/DocsPager.astro';
import { docEntry } from '../lib/docsNav';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
  headings?: { depth: number; slug: string; text: string }[];
  /** The docs start page: no article header, no prose wrapper, no page outline. */
  landing?: boolean;
}

const { title, description = '', currentSlug, headings = [], landing = false } = Astro.props;
const entry = docEntry(currentSlug);
const summary = entry?.summary ?? description;
const pageTitle = landing ? 'Plexi Docs' : `${title} · Plexi Docs`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const outline = headings.filter(h => h.depth === 2);
const showToc = !landing && outline.length > 1;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="theme-color" content="#16161e" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description || summary} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description || summary} />
  <meta property="og:site_name" content="Plexi" />
</head>
<body class="docs-body">
  <a class="skip-link" href="#article">Skip to article</a>
  <Texture />
  <Nav />
  <div class:list={['docs-shell', { 'no-toc': !showToc }]}>
    <DocsSidebar currentSlug={currentSlug} landing={landing} />
    <main class="docs-main" id="article" tabindex="-1">
      {landing ? (
        <slot />
      ) : (
        <article class:list={['docs-article', { reference: Boolean(entry?.generatedFrom) }]}>
          <header class="doc-header">
            <nav class="doc-crumbs" aria-label="Breadcrumb">
              <a href="/docs">Docs</a>
              {entry && <span aria-hidden="true">/</span>}
              {entry && <span>{entry.section}</span>}
            </nav>
            <h1>{title}</h1>
            {summary && <p class="doc-summary">{summary}</p>}
            {entry?.generatedFrom && (
              <p class="doc-generated">
                <span class="doc-generated-tag">Generated</span>
                <span>Built from {entry.generatedFrom}. It tracks the <code>alpha</code> branch, so it can be ahead of the release you have installed.</span>
              </p>
            )}
            {showToc && (
              <details class="doc-outline">
                <summary>On this page</summary>
                <ul>{outline.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
              </details>
            )}
          </header>
          <div class="prose prose-invert max-w-none">
            <slot />
          </div>
          <DocsPager currentSlug={currentSlug} />
        </article>
      )}
    </main>
    {showToc && <DocsToc headings={outline} />}
  </div>
  <Footer />
</body>
</html>

<script>
  // Sidebar: open on wide screens, collapsed behind its summary on narrow ones.
  const menu = document.querySelector<HTMLDetailsElement>('.docs-navigation');
  const narrow = window.matchMedia('(max-width: 980px)');
  const syncMenu = () => { if (menu) menu.open = !narrow.matches; };
  syncMenu();
  narrow.addEventListener('change', syncMenu);

  // Wide tables and code blocks scroll on their own; make the scroller keyboard reachable.
  const syncScrollStops = () => {
    document.querySelectorAll<HTMLElement>('.prose pre, .prose table').forEach(el => {
      if (el.scrollWidth > el.clientWidth) el.tabIndex = 0;
      else el.removeAttribute('tabindex');
    });
  };
  syncScrollStops();
  window.addEventListener('resize', syncScrollStops);

  // Copy button on every code block.
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach(pre => {
    const frame = document.createElement('div');
    frame.className = 'code-frame';
    pre.replaceWith(frame);
    frame.append(pre);
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = 'Copy';
    let reset: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      clearTimeout(reset);
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        button.textContent = 'Copied';
      } catch (error) {
        console.error('docs: copying a code block failed', error);
        button.textContent = 'Copy failed';
      }
      reset = setTimeout(() => { button.textContent = 'Copy'; }, 1600);
    });
    frame.append(button);
  });
</script>
